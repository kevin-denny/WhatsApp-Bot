# Node environment
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_bot?schema=public"

# WhatsApp Cloud API Credentials
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_meta_system_user_or_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v21.0

# Multi-tenant Default/Fallback Business ID (Used for Phase 1 single-business POC routing)
DEFAULT_BUSINESS_ID=
